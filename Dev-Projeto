<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Meu projeto - Inspirado</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: Arial, sans-serif;
            background-color: #f4f4f4;
        }

        header {
            background-color: #ff0000;
            padding: 15px 20px;
            color: #fff;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        header .logo {
            font-size: 1.8em;
            font-weight: bold;
        }

        header nav {
            display: flex;
            gap: 20px;
        }

        header nav a {
            color: #fff;
            text-decoration: none;
            font-size: 1em;
        }

        .search-bar {
            margin: 20px auto;
            display: flex;
            justify-content: center;
        }

        .search-bar input {
            width: 60%;
            padding: 10px;
            font-size: 1em;
            border: 1px solid #ccc;
            border-radius: 5px 0 0 5px;
        }

        .search-bar button {
            padding: 10px 20px;
            background-color: #ff0000;
            color: #fff;
            border: none;
            font-size: 1em;
            border-radius: 0 5px 5px 0;
            cursor: pointer;
        }

        .banner {
            width: 100%;
            height: 300px;
            background: url('https://via.placeholder.com/1920x300') center/cover no-repeat;
            margin-bottom: 20px;
        }

        .products {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
            padding: 20px;
        }

        .product {
            background: #fff;
            border: 1px solid #ddd;
            border-radius: 10px;
            text-align: center;
            padding: 15px;
            transition: transform 0.3s ease;
        }

        .product:hover {
            transform: scale(1.05);
        }

        .product img {
            width: 100%;
            border-radius: 10px 10px 0 0;
        }

        .product h3 {
            font-size: 1em;
            margin: 10px 0;
        }

        .product p {
            color: #888;
            font-size: 0.9em;
        }

        .product .price {
            font-size: 1.2em;
            color: #ff0000;
            font-weight: bold;
        }

        footer {
            background-color: #333;
            color: #fff;
            text-align: center;
            padding: 15px 0;
            margin-top: 20px;
        }

        footer p {
            font-size: 0.9em;
        }

        footer a {
            color: #ff0000;
            text-decoration: none;
        }
    </style>
</head>
<body>
    <header>
        <div class="logo">Dev</div>
        <nav>
            <a href="#">Ofertas</a>
            <a href="#">Categorias</a>
            <a href="#">Eletrônicos</a>
            <a href="#">Contato</a>
        </nav>
    </header>

    <div class="search-bar">
        <input type="text" placeholder="O que você está procurando?">
        <button>Buscar</button>
    </div>

    <div class="banner"></div>

    <section class="products">
        <div class="product">
            <img src="https://via.placeholder.com/200?text=Smartphone" alt="Smartphone">
            <h3>Smartphone XYZ</h3>
            <p>Alta performance e câmera incrível.</p>
            <p class="price">R$ 1.299,90</p>
        </div>
        <div class="product">
            <img src="https://via.placeholder.com/200?text=Smart+TV" alt="Smart TV">
            <h3>Smart TV 50"</h3>
            <p>Imagem 4K com qualidade impressionante.</p>
            <p class="price">R$ 2.499,90</p>
        </div>
        <div class="product">
            <img src="https://via.placeholder.com/200?text=Fone+Bluetooth" alt="Fone Bluetooth">
            <h3>Fone de Ouvido Bluetooth</h3>
            <p>Som de qualidade e conexão sem fio.</p>
            <p class="price">R$ 299,90</p>
        </div>
        <div class="product">
            <img src="https://via.placeholder.com/200?text=Notebook" alt="Notebook">
            <h3>Notebook Gamer</h3>
            <p>Alto desempenho para jogos e trabalho.</p>
            <p class="price">R$ 5.899,90</p>
        </div>
    </section>

    <footer>
        <p>© 2024 Dev. Todos os direitos reservados. <a href="#">Termos de uso</a> | <a href="#">Política de privacidade</a></p>
    </footer>
</body>
</html>
